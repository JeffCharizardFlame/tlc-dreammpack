desc[tlc-treasmtn]:

name = Super Solvers: Treasure Mountain!
icon = tlc-treasmtn.png
machine = pc
osenv = windows 98
audiohw = gmidi
launch = ""

config[display]:
    condition = is_dos()
    title = Display Adapter
    option[ega]: name = EGA; videohw = ega;
    option[cga]: name = CGA; videohw = cga;
    option[tandy]: name = Tandy; machine = tandy; videohw = cga;
end


//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// English MS-DOS
//
game[pc-dos-en]:
    name = English MS-DOS
    osenv = dos
    fixdivover = true
    mips = $(MIPS_386SX_20)
    ramkb = 1024
    audiohw = sb16
    rootpath = C:\TLC\SST
    launch = "$(rootpath)\SST.EXE"
    anchorfile = SST.EXE
    
    file[]: crc = 9da2663d; size =     43887; name = ALL_PUZS
    file[]: crc = 685e0463; size =     28432; name = BEGIN.PAK
