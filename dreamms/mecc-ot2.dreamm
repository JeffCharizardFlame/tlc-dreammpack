desc[mecc-ot2]:

name = Oregon Trail II
icon = mecc-ot2.png
machine = pc
rootpath = C:\MECC\OTII
launch = ""
osenv = windows 98
audiohw = gmidi
winres = 800x600x16

config[ossel]:
    condition = file_exists("$$(rootpath)\\OTII32.EXE");
    title = OS Select
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\OTII16.exe"; osenv = windows 3.11.002;
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\OTII32.exe"; osenv = windows 98;
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\OREGONII.INI", "$$(OREGONII_CONTENTS)");
        
    ]]]
end

//
// Version 1.0
//
