desc[tlc-cluefinders6th]:

name = The ClueFinders 6th Grade Adventures: Empire of the Plant People
icon = tlc-cluefinders6th.png
machine = pc
launch = "$(rootpath)\CF6.exe"
osenv = windows 98
winres = 800x600x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\CF6.INI", "$$(CF6_CONTENTS)");
    ]]]
end

script[registry-init]:
    code = [[[$(CRLF)
        winregistry_import_raw("$$(REGISTRY)");
    ]]]
end

//
// English (US), Version 1.0
//
game[pc-cd-en-us-1.0]:
    name = English (US) CD, Version 1.0
    anchorfile = CF6.exe
    anchordepth = 3
    rootpath = C:\Program Files\The Learning Company\The ClueFinders 6th Grade Adventures
    
