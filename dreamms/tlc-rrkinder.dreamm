desc[tlc-rrkinder]:

name = Reader Rabbit's Kindergarten
icon = tlc-rrkinder.png
machine = pc
rootpath = C:\TLCWIN\RRK
launch = ""
osenv = windows 98
audiohw = gmidi
winres = 640x480x8

config[ossel]:
    condition = file_exists("$$(rootpath)\\rrk.exe") && file_exists("$$(rootpath)\\rrk32.exe");
    title = OS Select
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\RRK.exe"; osenv = windows 3.11.002;
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\RRK32.exe"; osenv = windows 98;
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// English (US), Version 1.01
//
game[pc-cd-en-1.01]:
    name = English (US), Version 1.01
    anchorfile = RRK32.EXE
    anchordepth = 3
    
