desc[tlc-rrtoddler]:

name = Reader Rabbit's Toddler
icon = tlc-rrtoddler.png
machine = pc
rootpath = C:\TLCWIN\RRT
launch = "$(rootpath)\RRTW32.EXE"
osenv = windows 98
audiohw = gmidi
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\RRTW32.INI", "$$(RRTW32_CONTENTS)");
    ]]]
end

