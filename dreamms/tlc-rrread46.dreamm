desc[tlc-rrread46]:

name = Reader Rabbit's Reading Ages 4-6 / Reader Rabbit's Interactive Reading Journey
icon = tlc-rrread46.png
machine = pc
rootpath = C:\TLCWIN\RRREAD46
launch = ""
osenv = windows 98
winres = 640x480x8

config[ossel]:
    condition = file_exists("$$(rootpath)\\read4616.exe") && file_exists("$$(rootpath)\\read4632.exe");
    title = OS Select
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\read4616.exe"; osenv = windows 3.11.002;
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\read4632.exe"; osenv = windows 98;
	
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\RRIRJ.INI", "$$(RRIRJ_CONTENTS)");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS16_CONTENTS)"); condition = is_windows("windows 3.11.002");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS32_CONTENTS)"); condition = is_windows("windows 98");
    ]]]
end

//
// English (US) CD, Version 2.0
//
game[pc-cd-en-2.0]:
    name = English (US) CD, Version 2.0
    anchorfile = READ4616.EXE
    file[]: crc = 8636e5e9; size =    298496; name = READ4616.EXE
    file[]: crc = 494b2520; size =    229376; name = READ4632.EXE
    file[]: crc = a36f6a67; size =  26731008; name = CD\IRJ1DATA\IRJ1AO.DAT
    file[]: crc = 1d885279; size =  11812352; name = CD\IRJ1DATA\IRJ1POEM.DAT
    file[]: crc = a5d9af09; size =  32499712; name = CD\IRJ1DATA\IRJ1SND.DAT
    file[]: crc = 9365fbb5; size =   5148672; name = CD\IRJ1DATA\IRJ1U1.DAT
    file[]: crc = 5a0c9509; size =   6360064; name = CD\IRJ1DATA\IRJ1U2.DAT
    file[]: crc = b5f76a38; size =   7045120; name = CD\IRJ1DATA\IRJ1U3.DAT
    file[]: crc = 1eaf0377; size =   7885824; name = CD\IRJ1DATA\IRJ1U4.DAT
    file[]: crc = 6ce01e79; size =   9113088; name = CD\IRJ1DATA\IRJ1U5.DAT
    
    CDLABEL = RRREAD46
    RRIRJ_CONTENTS =  [[[$(CRLF)
[Reader Rabbit's Reading Ages 4-6]
CDDrive=D:\
]]]
    TLCAPPS16_CONTENTS = [[[$(CRLF)
[Reader Rabbit's Reading Ages 4-6]
Path=$(rootpath)\read4616.exe
]]]
    TLCAPPS32_CONTENTS = [[[$(CRLF)
[Reader Rabbit's Reading Ages 4-6]
Path=$(rootpath)\read4632.exe
]]]
end

