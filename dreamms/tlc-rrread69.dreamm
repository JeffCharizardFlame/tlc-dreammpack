desc[tlc-rrread69]:

name = Reader Rabbit's Reading Ages 6-9 / Reader Rabbit's Interactive Reading Journey 2
icon = tlc-rrread69.png
machine = pc
rootpath = C:\TLCWIN\RRREAD69
launch = ""
osenv = windows 98
winres = 640x480x8

config[ossel]:
    condition = file_exists("$$(rootpath)\\read6916.exe") && file_exists("$$(rootpath)\\read6932.exe");
    title = OS Select
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\read6916.exe"; osenv = windows 3.11.002;
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\read6932.exe"; osenv = windows 98;
	
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\RRIRJ2.INI", "$$(RRIRJ2_CONTENTS)");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS16_CONTENTS)"); condition = is_windows("windows 3.11.002");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS32_CONTENTS)"); condition = is_windows("windows 98");
    ]]]
end

//
// English CD, Version 1.1
//
game[pc-cd-en-1.1]:
    name = English (US) CD, Version 1.1
    anchorfile = READ6932.EXE
    file[]: crc = add07077; size =    303616; name = READ6916.EXE
    file[]: crc = dc2d98f1; size =    245760; name = READ6932.EXE
