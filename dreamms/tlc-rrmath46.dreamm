desc[tlc-rrmath46]:

name = Reader Rabbit's Math Ages 4-6
icon = tlc-rrmath46.png
machine = pc
rootpath = C:\TLCWIN\RRM46
launch = ""
osenv = windows 98
audiohw = gmidi
winres = 640x480x8

config[ossel]:
    title = OS Select
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\rrm46_16.exe"; osenv = windows 3.11.002;
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\rrm46_32.exe"; osenv = windows 98;
	
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\RRCIR.INI", "$$(RRCIR_CONTENTS)");
        file_save("$$(rootpath)\\RRM46.INI", "$$(RRM46_CONTENTS)");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS16_CONTENTS)"); condition = is_windows("windows 3.11.002");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS32_CONTENTS)"); condition = is_windows("windows 98");
    ]]]
end

//
// English CD (1998)
//
game[pc-cd-en]:
    name = English CD (1998)
    anchorfile = RRM46_32.EXE
    anchordepth = 4
    
