desc[tlc-rr2ndgrade]:

name = Reader Rabbit's 2nd Grade
icon = tlc-rr2ndgrade
machine = pc
rootpath = C:\TLCWIN\RR2G
launch = "$(rootpath)\rr2gw32.exe"
osenv = windows 98
winres = 640x480x8

config[ossel]:
    condition = file_exists("$$(rootpath)\\RR2GW16.EXE")
    title = OS Select
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\RR2GW16.exe"; osenv = windows 3.11.002;
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\RR2GW32.exe"; osenv = windows 98;
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\RR2G.INI", "$$(RR2G_CONTENTS)");
	
        
    ]]]
end

