desc[tlc-rrta]:

name = Reader Rabbit Thinking Adventures, Ages 4-6
icon = tlc-rrta.png
machine = pc
rootpath = C:\Program Files\The Learning Company\Reader Rabbit Thinking Adventures Ages 4-6
launch = "$(rootpath)\rrta32.exe"
osenv = windows 98
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\TRABBIT.INI", "$$(TRABBIT_CONTENTS)");
	
        
    ]]]
end

REGISTRY = [[[$(CRLF)
    REGEDIT4
   [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company]
   
   [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Products]
   
   [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Products\RTG3744AE]
   "Data"=hex:0c,00,01,00,ef,e0,b9,6a,ef,e0,b9,6a
   
   [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Reader Rabbit's Thinking Adventures]

   [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Reader Rabbit's Thinking Adventures\1.0]

   [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Reader Rabbit's Thinking Adventures\DataFile]
   @="$(rootpath)\\trabbit.DAT"

   [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Reader Rabbit's Thinking Adventures\DatFile]
   @="$(rootpath)\\trabbit.DAT"

   [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Reader Rabbit's Thinking Adventures\InstalledFile]
   @="$$(rootpath)\\rrta32.exe"

   [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Reader Rabbit's Thinking Adventures\InstalledPath]
   @="$$(rootpath)"

   [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Reader Rabbit's Thinking Adventures\MainExe]
   @="$$(rootpath)\\rrta32.exe"

   [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Reader Rabbit's Thinking Adventures\PreassesDir]
   @="D:\\Install\\Pls\\Preasses"

   [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Reader Rabbit's Thinking Adventures\PreassesExe]
   @="$$(rootpath)\\PreAssess.exe"

   [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Reader Rabbit's Thinking Adventures\Version]
   @="1.0"
    ]]]

script[init]:
    code = [[[$(CRLF)
    if (is_windows()) {
        winregistry_import_raw("$$(REGISTRY)");
    }
    ]]]
end

