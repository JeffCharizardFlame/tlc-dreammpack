desc[tlc-cluefinders5th]:

name = The ClueFinders 5th Grade Adventures: Secret of the Living Volcano
icon = tlc-cluefinders5th.png
machine = pc
launch = "$(rootpath)\5thad32.exe"
osenv = windows 98
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

mount[cdw]: vpath = D:\; srcpath = ram; writable = true

//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\5THADV.INI", "$$(5THADV_CONTENTS)");
    ]]]
end

script[registry-init]:
    code = [[[$(CRLF)
        winregistry_import_raw("$$(REGISTRY)");
    ]]]
end

//
// English (US), Version 1.0
//
game[pc-cd-en-us-1.0]:
    name = English (US) CD, Version 1.0
    anchorfile = 5thad32.exe
    anchordepth = 3
    rootpath = C:\Program Files\The Learning Company\The ClueFinders 5th Grade Adventures
    
