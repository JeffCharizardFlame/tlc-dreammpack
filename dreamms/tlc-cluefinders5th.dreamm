    CDLABEL = "CLUE5TH"
    5THADV_CONTENTS = [[[$(CRLF)
[Fifth Grade Adventures - CD]
CDDrive=D:\
UseDirectDraw=1
DisplayFullScreen=1
]]]
    REGISTRY = [[[$(CRLF)
REGEDIT4

[HKEY_LOCAL_MACHINE\Software\The Learning Company\The ClueFinders 5th Grade Adventures]

[HKEY_LOCAL_MACHINE\Software\The Learning Company\The ClueFinders 5th Grade Adventures\1.0]

[HKEY_LOCAL_MACHINE\Software\The Learning Company\The ClueFinders 5th Grade Adventures\InstalledFile]
@="$$(rootpath)\\5thad32.exe"

[HKEY_LOCAL_MACHINE\Software\The Learning Company\The ClueFinders 5th Grade Adventures\Version]
@="1.0"

[HKEY_LOCAL_MACHINE\Software\The Learning Company\The ClueFinders 5th Grade Adventures\InstalledPath]
@="$$(rootpath)"

[HKEY_LOCAL_MACHINE\Software\The Learning Company\The ClueFinders 5th Grade Adventures\MainExe]
@="$$(rootpath)\\5thad32.exe"

[HKEY_LOCAL_MACHINE\Software\The Learning Company\The ClueFinders 5th Grade Adventures\DataFile]
@="$$(rootpath)\\5thadv.dat"

[HKEY_LOCAL_MACHINE\Software\The Learning Company\The ClueFinders 5th Grade Adventures\DatFile]
@="$$(rootpath)\\5thadv.dat"

]]]
end

