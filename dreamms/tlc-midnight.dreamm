//
// English MS-DOS
//
game[pc-dos-en]:
    name = English MS-DOS
    osenv = dos
    fixdivover = true
    mips = $(MIPS_386DX_33)
    ramkb = 2048
    audiohw = sb16
    anchorfile = SSR.EXE
    
    file[]: crc = 3caf1306; size =     27191; name = CLOSE.GRA
