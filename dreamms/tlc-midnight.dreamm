desc[tlc-midnight]:

name = Super Solvers: Midnight Rescue
icon = tlc-midnight.png
machine = pc
launch = ""
osenv = windows 3.11.002


config[display]:
    condition = is_dos()
    title = Display Adapter
    option[ega]: name = EGA; videohw = ega;
    option[cga]: name = CGA; videohw = cga;
    option[herc]: name = Hercules; videohw = hercules;
	
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD; condition = is_windows()

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
    condition = is_windows()
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\SSRWINCD.INI", "$$(SSRWINCD_CONTENTS)");
    ]]]
end

//
// English Windows
//
game[pc-win-en]:
    name = English Windows
    anchorfile = SSRWINCD.EXE
    anchordepth = 2
    
