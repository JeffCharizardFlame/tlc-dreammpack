desc[tlc-readerrabbit2]:

name = Reader Rabbit 2 / Reader Rabbit's Reading 2
icon = tlc-readerrabbit2.png
machine = pc
osenv = windows 98
launch = ""

config[display]:
    condition = is_dos()
    title = Display Adapter
    option[vga]: name = VGA; videohw = vga;
    option[ega]: name = EGA; videohw = ega;
    option[cga]: name = CGA; videohw = cga;
    option[tandy]: name = Tandy; machine = tandy; videohw = cga;
end

config[ossel]:
    condition = is_windows() && file_exists("$$(rootpath)\\rrr232.exe")
    title = OS Select
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\rrr232.exe"; osenv = windows 98
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\rrr216.exe"; osenv = windows 3.11.002
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// English MS-DOS
//
game[pc-dos-en]:
    name = English MS-DOS
    rootpath = C:\TLC\RR2
    launch = "$(rootpath)\RR2.EXE"
    osenv = dos
    fixdivover = true
    mips = $(MIPS_386SX_20)
    ramkb = 1024
    audiohw = sb16
    anchorfile = RR2.EXE
    
    file[]: crc = 99caade8; size =      6041; name = ADSFX.ADL
