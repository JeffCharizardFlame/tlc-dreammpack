desc[tlc-cfread]:

name = The ClueFinders Reading Adventures, Ages 9-12
icon = tlc-cfread.png
machine = pc
rootpath = C:\Program Files\The Learning Company\The ClueFinders Reading Adventures Ages 9-12
launch = "$(rootpath)\cfread.exe"
osenv = windows 98
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\CFREAD.INI", "$$(CFREAD_CONTENTS)");
	
        
    ]]]
end

//
// English (US), Version 1.0
//
game[pc-cd-en-us-1.0]:
    name = English (US) CD, Version 1.0
    anchorfile = cfread.exe
    anchordepth = 3
    
