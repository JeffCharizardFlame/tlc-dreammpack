desc[tlc-spellbound]:

name = Super Solvers: Spellbound!
icon = tlc-spellbound.png
machine = pc
osenv = windows 98
launch = ""
audiohw = gmidi
winres = 640x480x8

config[ossel]:
    condition = is_windows() 
    title = OS Select
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\ssbcd.exe"; osenv = windows 3.11.002;
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\ssbwin32.exe"; osenv = windows 98;
	
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD; condition = is_windows()

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
    condition = is_windows()
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\SSBWINCD.INI", "$$(SSBWINCD_CONTENTS)");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS16_CONTENTS)"); condition = is_windows("windows 3.11.002");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS32_CONTENTS)"); condition = is_windows("windows 98");
    ]]]
end

//
// English MS-DOS
//
game[pc-dos-en]:
    name = English MS-DOS
    osenv = dos
    fixdivover = true
    mips = $(MIPS_386SX_20)
    ramkb = 1024
    audiohw = sb16
    rootpath = C:\TLC\SSB
    launch = "$(rootpath)\ssbprog.exe"
    anchorfile = ssbprog.exe
    
    file[]: crc = f1f75cd5; size =    241593; name = ssb000.dat
    file[]: crc = 21ffc76f; size =    361710; name = ssb001.dat
    file[]: crc = 568f6706; size =    361182; name = ssb002.dat
    file[]: crc = 4840f26f; size =    359401; name = ssb003.dat
    file[]: crc = 2534e33b; size =    357452; name = ssb004.dat
    file[]: crc = 0794d264; size =    359970; name = ssb005.dat
    file[]: crc = 33571fa1; size =    102647; name = ssbprog.exe
    
    CDLABEL = ""
    SSBWINCD_CONTENTS = ""
    TLCAPPS16_CONTENTS = ""
    TLCAPPS32_CONTENTS = ""
end

