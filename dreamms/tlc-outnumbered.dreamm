desc[tlc-outnumbered]:

name = Super Solvers: OutNumbered!
icon = tlc-outnumbered.png
machine = pc
launch = ""
osenv = windows 98
audiohw = gmidi
winres = 640x480x8

config[ossel]:
    condition = is_windows() && file_exists("$$(rootpath)\\SSOWINCD.EXE");
    title = OS Select
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\ssowincd.exe"; osenv = windows 3.11.002;
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\sso32.exe"; osenv = windows 98;
	
end

config[display]:
    condition = is_dos()
    title = Display Adapter
    option[ega]: name = EGA; launch = "$(rootpath)\ssoe.bat"; videohw = ega;
    option[cga]: name = CGA; launch = "$(rootpath)\ssoc.bat"; videohw = cga;
    option[herc]: name = Hercules; launch = "$(rootpath)\ssoh.bat"; videohw = hercules;
	
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD; condition = is_windows()

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
    condition = is_windows()
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\SSOWINCD.INI", "$$(SSOWINCD_CONTENTS)");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS16_CONTENTS)"); condition = is_windows("windows 3.11.002");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS32_CONTENTS)"); condition = is_windows("windows 98");
    ]]]
end

//
// English Windows
