desc[tlc-mathrabbit]:

name = Math Rabbit / Reader Rabbit's Math 1
icon = tlc-mathrabbit.png
machine = pc
launch = ""
osenv = windows 98
audiohw = gmidi

config[display-2.0]:
    condition = is_dos() && file_exists("$$(rootpath)\\MR000.DAT")
    title = Display Adapter
    option[vga]: name = VGA; videohw = vga;
    option[ega]: name = EGA; videohw = ega;
    option[cga]: name = CGA; videohw = cga;
    option[tandy]: name = Tandy; machine = tandy; videohw = cga;
end

config[ossel-mr]:
    condition = is_windows() && file_exists("$$(rootpath)\\mrwincd.exe");
    title = OS Select
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\mrwin32.exe"; osenv = windows 98
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\mrwincd.exe"; osenv = windows 3.11.002
end

config[ossel-mruk]:
    condition = is_windows() && file_exists("$$(rootpath)\\mrwin16.exe");
    title = OS Select
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\mrwin32.exe"; osenv = windows 98
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\mrwin16.exe"; osenv = windows 3.11.002
end

config[ossel-rrm1]:
    condition = is_windows() && file_exists("$$(rootpath)\\rrm1_16.exe");
    title = OS Select
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\rrm1_32.exe"; osenv = windows 98
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\rrm1_16.exe"; osenv = windows 3.11.002
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// English MS-DOS Version 1.1
//
game[pc-dos-en]:
    name = English MS-DOS Version 1.1
    rootpath = C:\TLC\MR
    launch = "$(rootpath)\MR.EXE"
    osenv = dos
    fixdivover = true
    mips = $(MIPS_286_10)
    ramkb = 640
    audiohw = speaker
    videohw = cga
    anchorfile = MR.EXE
    file[]: crc = 5fd35a30; size =       768; name = ALTFONT
    file[]: crc = a08d2ed7; size =      2944; name = CLOWNMEN.CMP
