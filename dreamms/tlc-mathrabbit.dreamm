    file[]: crc = 8169a064; size =      7936; name = MRTITLE.CMP
    file[]: crc = 8254621c; size =       384; name = MRTRAIN.IND
    file[]: crc = 1e085873; size =      7808; name = MRTRAIN.REL
    file[]: crc = 05e3d58a; size =      2816; name = RABFONT
end

