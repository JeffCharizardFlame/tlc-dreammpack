desc[tlc-rrmath69]:

name = Reader Rabbit's Math Ages 6-9
icon = tlc-rrmath69.png
machine = pc
rootpath = C:\TLCWIN\MATH6-9
launch = ""
osenv = windows 98
audiohw = gmidi
winres = 800x600x16

config[ossel]:
    condition = file_exists("$$(rootpath)\\rrm69_16.exe");
    title = OS Select
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\rrm69_16.exe"; osenv = windows 3.11.002;
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\rrm69_32.exe"; osenv = windows 98;
	
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\MATH6-9.INI", "$$(MATH69_CONTENTS)");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS16_CONTENTS)"); condition = is_windows("windows 3.11.002");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS32_CONTENTS)"); condition = is_windows("windows 98");
    ]]]
end

//
// English CD (1998)
//
game[pc-cd-en]:
    name = English (US) CD, Version 1.0
    anchorfile = RRM69_32.EXE
    anchordepth = 3
