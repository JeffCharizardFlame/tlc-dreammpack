desc[tlc-cluefinders3rd]:

name = The ClueFinders 3rd Grade Adventures: Mystery of Mathra
icon = tlc-cluefinders3rd.png
machine = pc
rootpath = C:\TLCWIN\3RDADV
launch = ""
osenv = windows 98
winres = 640x480x8

config[ossel]:
    condition = file_exists("$$(rootpath)\\3rdadv16.exe");
    title = OS Select
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\3rdadv16.exe"; osenv = windows 3.11.002;
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\3rdadv32.exe"; osenv = windows 98;
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD; writable = true

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS16_CONTENTS)"); condition = is_windows("windows 3.11.002");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS32_CONTENTS)"); condition = is_windows("windows 98");
	
        
    ]]]
end

