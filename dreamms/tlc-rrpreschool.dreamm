desc[tlc-rrpreschool]:

name = Reader Rabbit's Preschool / Let's Start Learning!
icon = tlc-rrpreschool.png
machine = pc
launch = ""
osenv = windows 98
audiohw = gmidi
winres = 640x480x16

config[ossel]:
    condition = is_windows()
    title = OS Select
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\$(32EXENAME)"; osenv = windows 98
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\$(16EXENAME)"; osenv = windows 3.11.002
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// English CD - Let's Start Learning! (1.1)
//
game[pc-cd-en-1.1]:
    name = English CD Version 1.1 - Let's Start Learning!
    rootpath = C:\TLCWIN\LSLWIN
    anchorfile = LSLWIN32.EXE
    file[]: crc = 6cb84fbe; size =  21907138; name = GRAPHIC.DLL
    file[]: crc = 1555ebf0; size =    250880; name = LSLWIN.EXE
    file[]: crc = cef45103; size =    212992; name = LSLWIN32.EXE
    file[]: crc = 77cb67d0; size =  18024523; name = MUSIC.DLL
    file[]: crc = 18b52e75; size =  29775947; name = SOUNDS.DLL
    file[]: crc = 3b03e483; size =  26938955; name = SPEECH.DLL
    
    16EXENAME = LSLWIN.EXE
    32EXENAME = LSLWIN32.EXE
end

