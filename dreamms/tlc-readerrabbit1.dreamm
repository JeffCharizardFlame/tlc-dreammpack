desc[tlc-readerrabbit1]:

name = Reader Rabbit 1 / Reader Rabbit's Reading 1
icon = tlc-readerrabbit1.png
machine = pc
osenv = windows 98
launch = ""

config[display-4.1]:
    condition = is_dos() && file_exists("$$(rootpath)\\menu")
    title = Display Adapter
    option[ega]: name = EGA; videohw = ega;
    option[cga]: name = CGA; videohw = cga;
    option[hercules]: name = Hercules; videohw = hercules;
end

config[display-5.01]:
    condition = is_dos() && file_exists("$$(rootpath)\\RR000.DAT")
    title = Display Adapter
    option[vga]: name = VGA; videohw = vga;
    option[ega]: name = EGA; videohw = ega;
    option[cga]: name = CGA; videohw = cga;
    option[tandy]: name = Tandy; machine = tandy; videohw = cga;
end

config[ossel]:
    condition = is_windows() && file_exists("$$(rootpath)\\rr1cd32.exe")
    title = OS Select
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\rr1cd32.exe"; osenv = windows 98
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\rr1cd16.exe"; osenv = windows 3.11.002
end

config[ossel-2]:
    condition = is_windows() && file_exists("$$(rootpath)\\rrr132.exe")
    title = OS Select
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\rrr132.exe"; osenv = windows 98
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\rrr116.exe"; osenv = windows 3.11.002
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// English MS-DOS Version 4.1
//
game[pc-dos-en-4.1]:
    name = English MS-DOS Version 4.1
    rootpath = C:\TLC\RR
    launch = "$(rootpath)\RR.EXE"
    osenv = dos
    fixdivover = true
    mips = $(MIPS_286_10)
    ramkb = 640
    audiohw = speaker
    videohw = ega
    anchorfile = RR.EXE
    
