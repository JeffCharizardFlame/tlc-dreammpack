desc[tlc-zoombinis2]:

name = Zoombinis 2 Mountain Rescue
icon = tlc-zoombinis2.png
machine = pc
rootpath = C:\Program Files\The Learning Company\Zoombinis Mountain Rescue\
launch = "$(rootpath)\zoombini2.exe"
osenv = windows 98
winres = 800x600x32

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

REGISTRY = [[[$(CRLF)
    REGEDIT4
    [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company]
    
    [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Products]
    
    [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Products\380860]
    "Data"=hex:0c,00,01,00,d7,1c,89,6a,d7,1c,89,6a
    
    [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Zoombini2]
    "CD"="D:\\Data\\"
    
    [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Zoombini2\1.0]
    
    [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Zoombini2\InstalledFile]
    @="C:\\Program Files\\The Learning Company\\Zoombinis Mountain Rescue\\Zoombini2.exe"
    
    [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Zoombini2\InstalledPath]
    @="C:\\Program Files\\The Learning Company\\Zoombinis Mountain Rescue"
    
    [HKEY_LOCAL_MACHINE\SOFTWARE\The Learning Company\Zoombini2\Version]
    @="1.0"
    ]]]

script[init]:
    code = [[[$(CRLF)
    if (is_windows()) {
        winregistry_import_raw("$$(REGISTRY)");
    }
    ]]]
end


