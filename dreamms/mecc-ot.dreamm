desc[mecc-ot]:

name = The Oregon Trail
icon = mecc-ot.png
machine = pc
osenv = windows 98

config[mode-vga]:
    condition = is_dos() && file_exists("$$(rootpath)\\OREGON.GXL");
    title = Game Mode
    option[main]:  name = Play Game; launch = "$(rootpath)\OREGON.EXE";
    option[config]: name = Config Tool; launch = "$(rootpath)\SETUP.BAT";
end

config[display]:
    condition = is_dos() && file_exists("$$(rootpath)\\LOGO.256");
    title = Display Adapter
    option[vga]: name = VGA; videohw = vga;
    option[cga]: name = EGA; videohw = ega;
    option[cga]: name = CGA; videohw = cga;
end



//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// MS-DOS version 1.0;
//
game[pc-dos-en-1.0]:
    name = MS-DOS, Version 1.0
    anchorfile = OREGON.EXE
    rootpath = C:\MECC\OREGON
    launch = "$(rootpath)\OREGON.EXE"
    osenv = dos
    fixdivover = true
    mips = 0.25
    ramkb = 512
    audiohw = sb16
    
    file[]: crc = 9744624b; size =      2646; name = BIT8X8.GFT
