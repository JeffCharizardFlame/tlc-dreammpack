desc[tlc-readerrabbit3]:

name = Reader Rabbit 3
icon = tlc-readerrabbit3.png
machine = pc
osenv = windows 98
launch = ""

config[display]:
    condition = is_dos()
    title = Display Adapter
    option[vga]: name = VGA; videohw = vga;
    option[ega]: name = EGA; videohw = ega;
    option[cga]: name = CGA; videohw = cga;
    option[tandy]: name = Tandy; machine = tandy; videohw = cga;
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// English MS-DOS
//
game[pc-dos-en]:
    name = English MS-DOS
    rootpath = C:\TLC\RR3
    launch = "$(rootpath)\READER3.EXE"
    osenv = dos
    fixdivover = true
    mips = $(MIPS_386SX_20)
    ramkb = 1024
    audiohw = sb16
    anchorfile = READER3.EXE
    
    file[]: crc = c3e60491; size =      2014; name = PLAYERS.DAT
    file[]: crc = eebc62ce; size =    192736; name = READER3.EXE
    file[]: crc = a20fffed; size =    317725; name = RR300.DAT
    file[]: crc = 4e726665; size =    340101; name = RR301.DAT
