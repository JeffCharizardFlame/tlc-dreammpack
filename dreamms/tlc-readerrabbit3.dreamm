    file[]: crc = 36bfab3f; size =    292889; name = RR306.DAT
    file[]: crc = 54d4cbd5; size =    330848; name = RR307.DAT

end

//
// English Windows
//
game[pc-win-en]:
    name = English Windows - Reader Rabbit 3 Deluxe!
    anchorfile = rr3win.exe
    anchordepth = 3
    osenv = windows 98
    rootpath = C:\TLCWIN\RR3WIN
    launch = "$(rootpath)\RR3WIN.exe"
    audiohw = gmidi
    winres = 640x480x8
    
