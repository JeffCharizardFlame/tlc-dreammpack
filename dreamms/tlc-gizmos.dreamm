desc[tlc-gizmos]:

name = Super Solvers: Gizmos & Gadgets!
icon = tlc-gizmos.png
machine = pc
launch = ""
osenv = windows 98
audiohw = gmidi
winres = 640x480x8

config[ossel]:
    condition = is_windows() && file_exists("$$(rootpath)\\ssgwincd.exe");
    title = OS Select
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\ssgwincd.exe"; osenv = windows 3.11.002;
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\ssgwin32.exe"; osenv = windows 98;
	
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD; optional = true

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\SSGWINCD.INI", "$$(SSGWINCD_CONTENTS)"); condition = is_windows();
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS16_CONTENTS)"); condition = is_windows("windows 3.11.002");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS32_CONTENTS)"); condition = is_windows("windows 98");
    ]]]
end

