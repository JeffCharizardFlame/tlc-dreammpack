desc[tlc-mathjourney]:

name = Reader Rabbit Presents: Math Journey for Grades 1-3 / Interactive Math Journey
icon = tlc-mathjourney.png
machine = pc
rootpath = C:\TLCWIN\IMJ
launch = ""
osenv = windows 98
winres = 640x480x8

config[ossel]:
    condition = file_exists("$$(rootpath)\\IMJ.EXE") && file_exists("$$(rootpath)\\IMJ32.EXE");
    title = OS Select
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\IMJ.exe"; osenv = windows 3.11.002;
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\IMJ32.exe"; osenv = windows 98;
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\IMJ.INI", "$$(IMJ_CONTENTS)");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS16_CONTENTS)"); condition = is_windows("windows 3.11.002");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS32_CONTENTS)"); condition = is_windows("windows 98");
	
        
    ]]]
end

