desc[tlc-rrletters]:

name = Reader Rabbit's Ready for Letters
icon = tlc-rrletters.png
machine = pc
rootpath = C:\TLC\RFL
launch = $(rootpath)\RFL.EXE
osenv = dos
fixdivover = true
mips = $(MIPS_386SX_20)
ramkb = 1024
audiohw = sb16
videohw = svga

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// English MS-DOS
//
game[pc-dos-en]:
    name = English MS-DOS
    anchorfile = RFL.EXE
