desc[tlc-treasmthstrm]:

name = Super Seekers: Treasure MathStorm!
icon = tlc-treasmthstrm.png
machine = pc
osenv = windows 98
launch = ""
audiohw = gmidi


//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// English MS-DOS;
//
game[pc-dos-en]:
    name = English MS-DOS
    osenv = dos
    fixdivover = true
    mips = $(MIPS_386SX_20)
    ramkb = 1024
    rootpath = C:\TLC\TMS
    videohw = svga
    audiohw = sb16
    anchorfile = tmprog.exe
    
    file[]: crc = b8dfd26b; size =     38298; name = tm000.dat
    file[]: crc = 54bd2835; size =    317123; name = tm001.dat
    file[]: crc = a908aa2f; size =    257848; name = tm002.dat
    file[]: crc = afdb8974; size =      7334; name = tmhelp.txt
    file[]: crc = 2f88f494; size =      5826; name = tmhint.txt
    file[]: crc = 687a816c; size =    151716; name = tmprog.exe
    file[]: crc = b78683d1; size =      4418; name = tmusers.dat
    
    launch = "$(rootpath)\tmprog.exe"
    

end

