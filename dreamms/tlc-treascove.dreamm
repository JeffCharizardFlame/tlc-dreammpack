desc[tlc-treascove]:

name = Super Seekers: Treasure Cove!
icon = tlc-treascove.png
machine = pc
osenv = windows 98
launch = ""
audiohw = gmidi
winres = 640x480x8
VER11 = 0
VER20 = 0

config[ossel]:
    condition = is_windows() 
    title = OS Select
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\tcvwin.exe"; osenv = windows 3.11.002;
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\tcvwin32.exe"; osenv = windows 98;
	
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD; condition = is_windows()

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
    condition = is_windows()
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\TCVWIN.INI", "$$(TCVWIN_CONTENTS)"); condition = !$(VER11);
        file_save("$$(rootpath)\\TCVCD.INI", "$$(TCVCD_CONTENTS)"); condition = !$(VER20);
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS16_CONTENTS)"); condition = is_windows("windows 3.11.002");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS32_CONTENTS)"); condition = is_windows("windows 98");
    ]]]
end

//
// English MS-DOS
//
game[pc-dos-en]:
    name = English MS-DOS
    anchorfile = COVE.EXE
    osenv = dos
    fixdivover = true
    mips = $(MIPS_386SX_20)
    ramkb = 1024
    audiohw = sb16
    rootpath = C:\TLC\SSTC
    launch = "$(rootpath)\COVE.EXE"

    file[]: crc = 6c46081f; size =    156928; name = COVE.EXE
    file[]: crc = 20277038; size =     13018; name = INSTALL.EXE
    file[]: crc = 57f507da; size =       858; name = README.TFF
    file[]: crc = 9fcf4fed; size =    148347; name = TC000.DAT
    file[]: crc = 07ca2507; size =    266438; name = TC001.DAT
    file[]: crc = 9d185d65; size =    342322; name = TC002.DAT
    file[]: crc = 5cf3e7a8; size =    342939; name = TC003.DAT
    file[]: crc = 980dc6ac; size =     13188; name = TC004.DAT
    file[]: crc = 21846dd2; size =       766; name = TCV.ICO
    
    CDLABEL = ""
    TCVWIN_CONTENTS = ""
    TCVCD_CONTENTS = ""
    TLCAPPS16_CONTENTS = ""
    TLCAPPS32_CONTENTS = ""
end

