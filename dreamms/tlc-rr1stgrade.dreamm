desc[tlc-rr1stgrade]:

name = Reader Rabbit's 1st Grade
icon = tlc-rr1stgrade.png
machine = pc
rootpath = C:\TLCWIN\RRF
launch = "$(rootpath)\RRF.EXE"
osenv = windows 98
audiohw = gmidi
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\RRF.INI", "$$(RRF_CONTENTS)");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS_CONTENTS)")
    ]]]
end

