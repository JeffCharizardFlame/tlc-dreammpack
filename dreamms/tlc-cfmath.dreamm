desc[tlc-cfmath]:

name = The ClueFinders Math Adventures, Ages 9-12
icon = tlc-cfmath.png
machine = pc
launch = "$(rootpath)\cfmath32.exe"
osenv = windows 98
winres = 800x600x8

config[ossel]:
    condition = file_exists("$$(rootpath)\\tcfm16.exe");
    title = OS Select
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\tcfm16.exe"; osenv = windows 3.11.002;
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\tcfm32.exe"; osenv = windows 98;
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\CFM.INI", "$$(CFM_CONTENTS)");
	
        
    ]]]
end

