desc[tlc-cfsearchsolve]:

name = The ClueFinders Search & Solve Adventures: The Phantom Amusement Park
icon = tlc-cfsearchsolve.png
machine = pc
launch = "$(rootpath)\cfsearch.exe"
osenv = windows 98
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

mount[cdw]: vpath = D:\; srcpath = ram; writable = true

//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\CFSEARCH.INI", "$$(CFSEARCH_CONTENTS)");
    ]]]
end

script[registry-init]:
    code = [[[$(CRLF)
        winregistry_import_raw("$$(REGISTRY)");
    ]]]
end

//
// English (US) CD, Version 1.0
//
game[pc-cd-en-us]:
    name = English (US) CD, Version 1.0
    anchorfile = cfsearch.exe
    anchordepth = 3
    rootpath = C:\Program Files\The Learning Company\ClueFinders Search & Solve Adventures
    
