desc[tlc-cluefinders4th]:

name = The ClueFinders 4th Grade Adventures: Puzzle of the Pyramid
icon = tlc-cluefinders4th.png
machine = pc
rootpath = C:\TLCWIN\CFNDR4TH
launch = ""
osenv = windows 98
winres = 800x600x8

config[ossel]:
    condition = file_exists("$$(rootpath)\\4thadv16.exe");
    title = OS Select
    option[win31]: name = Windows 3.1; launch = "$(rootpath)\4thadv16.exe"; osenv = windows 3.11.002;
    option[win9x]: name = Windows 9x; launch = "$(rootpath)\4thadv32.exe"; osenv = windows 98;
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
        file_save("$$(rootpath)\\4THADV.INI", "$$(4THADV_CONTENTS)");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS16_CONTENTS)"); condition = is_windows("windows 3.11.002");
        file_save("C:\\WINDOWS\\TLCAPPS.INI", "$$(TLCAPPS32_CONTENTS)"); condition = is_windows("windows 98");
    ]]]
end

//
// US English CD, Version 1.0
//
game[pc-cd-en-us-1.0]:
    name = English (US) CD, Version 1.0
    anchorfile = 4thadv16.exe
    anchordepth = 3
